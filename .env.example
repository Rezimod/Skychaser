# Stellar Explore + Stellar Academy. Set these in the Vercel project
# (Settings → Environment Variables). All are public (NEXT_PUBLIC_) except
# STELLAR_API_ORIGIN; no secret is needed, because this app has no server of
# its own: /api/* is forwarded to the Stellar platform.

# Sign-in for the game (the same Privy app as the Stellar website). Add this
# deployment's domain to the Privy app's allowed origins.
NEXT_PUBLIC_PRIVY_APP_ID=

# Shared bases / multiplayer rooms (the same Supabase project as the website).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solana, for the sign-in wallet (the same values as the website).
NEXT_PUBLIC_SOLANA_CLUSTER=
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_HELIUS_RPC_URL=

# Where /api/* goes. Defaults to the Stellar platform's deployment.
STELLAR_API_ORIGIN=https://stellarsky.vercel.app
