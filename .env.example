# Skychaser — the card product. Every variable the code reads, and what it is for.
# Production (Vercel project skychaser) needs every one marked REQUIRED.

# === Auth (REQUIRED) ===
NEXT_PUBLIC_PRIVY_APP_ID=           # Privy dashboard → App ID
PRIVY_APP_SECRET=                   # Privy dashboard → App Secret (server-only, never NEXT_PUBLIC_)

# === Database (REQUIRED) ===
DATABASE_URL=                       # Neon → the skychaser branch's connection string

# === Solana (REQUIRED) ===
# Production takes payments on mainnet only, and refuses them unless the RPC host says "mainnet".
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta   # mainnet-beta | devnet — explorer links, Privy chain, CSP
SOLANA_RPC_URL=                     # Server RPC that confirms payments (Helius mainnet, its own key)
NEXT_PUBLIC_SOLANA_RPC_URL=         # Browser RPC (Helius mainnet; a separate key, restricted to skychaser.io and stellarr.club)
NEXT_PUBLIC_HELIUS_RPC_URL=         # Optional browser fallback
NEXT_PUBLIC_MERCHANT_WALLET=        # Public address that receives every payment. A wallet used for nothing else.

# === Rate limiting (REQUIRED for real payments) ===
# Upstash → Redis → REST API. Exactly these names: without them, production taking real
# payments refuses every purchase (503) rather than run unlimited.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Capsules (REQUIRED) ===
# Seals each capsule's secret at rest (AES-256-GCM). Losing it strands every unopened capsule;
# the go-live reset checks the local copy matches. Generate: openssl rand -hex 32
CAPSULE_SEAL_KEY=
CRON_SECRET=                        # openssl rand -hex 32 — the daily sweeps (vercel.json) and admin calls
ADMIN_WALLETS=                      # Optional: comma-separated wallets allowed to list and void capsules

# === Alerts (REQUIRED for real payments) ===
# Every payment owed back is sent here, and the daily count of refunds owed.
TELEGRAM_BOT_TOKEN=                 # @BotFather → /newbot → token
TELEGRAM_CHAT_ID=                   # message the bot, then api.telegram.org/bot<TOKEN>/getUpdates → chat.id

# === Switches ===
# Emergency pause for every value-moving route. Instant: scripts/skychaser-pause.ts on|off (database
# flag). This variable works too, but only once a new deployment carries it (redeploy).
STELLAR_PAUSED=
STELLAR_INVITE_CODES=               # Optional: comma-separated codes; set = closed beta behind /invite
SKYCHASER_WELCOME=                  # Optional: 'off' stops the first card given on sign-in (src/lib/skychaser/welcome.ts)

# === Scripts only (never on Vercel) ===
# STELLAR_DATABASE_CONFIRM=stellar  # Typed on the command line by every scripts/skychaser-* run
